RewriteEngine On

# Map the aliases internally; only the browser-visible URL is changed.
RewriteRule ^a8f2b9/?$ admin.html [NC,L]
RewriteRule ^9x2k7a/?$ index.html [NC,L]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+admin\.html(?:\?[^ ]*)?\s [NC]
RewriteRule ^admin\.html$ /a8f2b9 [R=302,L]
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+index\.html(?:\?[^ ]*)?\s [NC]
RewriteRule ^index\.html$ /9x2k7a [R=302,L]
